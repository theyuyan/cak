{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "kernel/**/*.ts",
    "sdk/**/*.ts",
    "plugins/**/*.ts",
    "spike/**/*.ts",
    "tests/**/*.ts",
    "docs/design/03_INTERFACE_CONTRACTS.ts"
  ]
}