{
  "name": "browser.act",
  "version": "1.0.0",
  "description": "在当前页面做一步操作：click / type（往输入框写字）/ press（按键，如 Enter）/ select / scroll / back；目标用上一份快照里的 ref。返回操作后的新快照。",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "click",
          "type",
          "press",
          "select",
          "scroll",
          "back"
        ]
      },
      "ref": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "value": {
        "type": "string"
      },
      "deltaY": {
        "type": "integer"
      },
      "submit": {
        "type": "boolean",
        "default": false
      },
      "maxChars": {
        "type": "integer",
        "minimum": 200,
        "maximum": 200000,
        "default": 20000
      },
      "maxElements": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300,
        "default": 80
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "url",
      "title",
      "text",
      "truncated",
      "elements"
    ],
    "additionalProperties": false,
    "properties": {
      "url": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "elements": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "ref",
            "role",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          }
        }
      },
      "screenshotPngBase64": {
        "type": "string"
      }
    }
  },
  "defaultTimeoutMs": 45000,
  "permissions": [
    "net.fetch"
  ],
  "sideEffects": "external",
  "idempotent": false,
  "async": false,
  "schemaDigest": "sha256:53991575f32abd58cbb1759d7da3564516f803ecc804cf49125bda7e7e7fff9e"
}
