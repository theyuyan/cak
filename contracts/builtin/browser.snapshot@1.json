{
  "name": "browser.snapshot",
  "version": "1.0.0",
  "description": "重新读取当前页面快照；可选附带截图（PNG base64，限尺寸）。",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "screenshot": {
        "type": "boolean",
        "default": false
      },
      "maxChars": {
        "type": "integer",
        "minimum": 200,
        "maximum": 200000,
        "default": 20000
      },
      "maxElements": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300,
        "default": 80
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "url",
      "title",
      "text",
      "truncated",
      "elements"
    ],
    "additionalProperties": false,
    "properties": {
      "url": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "elements": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "ref",
            "role",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          }
        }
      },
      "screenshotPngBase64": {
        "type": "string"
      }
    }
  },
  "defaultTimeoutMs": 30000,
  "permissions": [
    "net.fetch"
  ],
  "sideEffects": "external",
  "idempotent": false,
  "async": false,
  "schemaDigest": "sha256:0033b7cc89d9f479e6a704ba20170426f8af3421b9710ac23045e0e21fda0415"
}
