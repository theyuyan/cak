{
  "name": "file.edit",
  "version": "1.0.0",
  "description": "精确替换 workspace 内文本文件的一段内容：oldText 必须在文件里恰好出现一次（replaceAll=true 时允许多次），否则失败不写。改局部用它，别用 file.write 整文件覆盖。副作用 write。",
  "inputSchema": {
    "type": "object",
    "required": [
      "path",
      "oldText",
      "newText"
    ],
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "oldText": {
        "type": "string",
        "minLength": 1
      },
      "newText": {
        "type": "string"
      },
      "replaceAll": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "path",
      "replacements",
      "bytes"
    ],
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "replacements": {
        "type": "integer"
      },
      "bytes": {
        "type": "integer"
      },
      "digest": {
        "type": "string"
      }
    }
  },
  "permissions": [
    "fs.write"
  ],
  "sideEffects": "write",
  "idempotent": false,
  "async": false,
  "defaultTimeoutMs": 5000,
  "schemaDigest": "sha256:ef450ddf7a1de5ff74471e45f8aff05e42c1823c65ebd2314432e13ffabe111c"
}
